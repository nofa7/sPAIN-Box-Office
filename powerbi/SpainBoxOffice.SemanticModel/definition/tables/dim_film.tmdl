table dim_film
	lineageTag: 3db4b2f5-136f-5b48-968e-f2288d843c3d

	/// Films that opened in the Top 25 (excl. re-releases)
	measure 'New Releases' = COUNTROWS(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE()))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 39c9019d-32ba-5458-b132-8ee5dc0025ae

	/// Lifetime gross of new releases
	measure 'Release Gross' = SUMX(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE()), dim_film[total_gross_eur])
		formatString: €#,0
		displayFolder: KPIs
		lineageTag: 8ac21ae6-0a15-55e9-89f3-1b0ddaf3349b

	/// Median opening-weekend gross
	measure 'Median Opening' = MEDIANX(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE()), dim_film[opening_gross_eur])
		formatString: €#,0
		displayFolder: KPIs
		lineageTag: 8a19b51c-61b7-5050-97f4-9e70bda3b8c4

	/// Median lifetime gross per new release
	measure 'Median Film Gross' = MEDIANX(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE()), dim_film[total_gross_eur])
		formatString: €#,0
		displayFolder: KPIs
		lineageTag: 2f7e85bf-ccca-5c99-8107-97a67fb1de40

	/// Share of new releases grossing 1M EUR or more
	measure 'Hit Rate (1M+)' =
			VAR _hits = COUNTROWS(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE() && dim_film[total_gross_eur] >= 1000000))
			RETURN
			    DIVIDE(_hits, [New Releases])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 93d6e58a-9c4c-5c8c-bc3b-41df004fd7b7

	/// Median lifetime gross / opening weekend
	measure 'Median Legs' = MEDIANX(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE() && NOT ISBLANK(dim_film[legs_multiple])), dim_film[legs_multiple])
		formatString: 0.00x
		displayFolder: KPIs
		lineageTag: b1e0035d-b5d5-5fe1-a538-8c9a0844c1c5

	/// Share of new releases that are Spanish films
	measure 'Spanish Share of Releases' =
			VAR _all = CALCULATE([New Releases], REMOVEFILTERS(dim_film[origin]))
			RETURN
			    DIVIDE(CALCULATE([New Releases], dim_film[origin] = "Spanish"), _all)
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 01e3e9b2-302b-5b29-a509-fde09cbe4e44

	/// Share of new releases' lifetime gross earned by Spanish films
	measure 'Spanish Share of Release Gross' =
			VAR _all = CALCULATE([Release Gross], REMOVEFILTERS(dim_film[origin]))
			RETURN
			    DIVIDE(CALCULATE([Release Gross], dim_film[origin] = "Spanish"), _all)
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: b5ed6abf-d339-5866-bc2c-d80fb89434fc

	/// Median opening gross per cinema
	measure 'Median Opening per Cinema' = MEDIANX(FILTER(dim_film, dim_film[opened_in_top25] = TRUE() && dim_film[is_rerelease] = FALSE() && NOT ISBLANK(dim_film[opening_per_cinema_eur])), dim_film[opening_per_cinema_eur])
		formatString: €#,0
		displayFolder: KPIs
		lineageTag: f5817ab9-1a79-5fb5-aeb9-d0723f6525a9

