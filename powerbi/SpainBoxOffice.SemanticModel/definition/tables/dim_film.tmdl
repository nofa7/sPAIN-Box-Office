	partition dim_film = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_film.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"film_id", type text}, {"title", type text}, {"original_title", type text}, {"distributor", type text}, {"origin", type text}, {"release_weekend", type date}, {"release_year", Int64.Type}, {"release_month_num", Int64.Type}, {"release_month", type text}, {"release_season", type text}, {"is_rerelease", type logical}, {"opened_in_top25", type logical}, {"opening_gross_eur", type number}, {"opening_admissions", type number}, {"opening_screens", type number}, {"opening_cinemas", type number}, {"opening_cinemas_band", type text}, {"opening_rank", type number}, {"opening_per_screen_eur", type number}, {"opening_per_cinema_eur", type number}, {"total_gross_eur", Int64.Type}, {"total_admissions", Int64.Type}, {"avg_ticket_eur", type number}, {"legs_multiple", type number}, {"weeks_in_top25", Int64.Type}, {"last_weeks_on_release", Int64.Type}, {"peak_screens", type number}, {"best_rank", Int64.Type}, {"gross_band", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
